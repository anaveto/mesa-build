From dce62b06f1a6a9e75e414e4f9149def6f633e859 Mon Sep 17 00:00:00 2001
From: Sagar Ghuge <sagar.ghuge@intel.com>
Date: Thu, 12 Nov 2026 16:29:00 -0800
Subject: [PATCH] Jay: Dont' predicate SEND with gateway message

Jay scoreboarding pass insert sync.bar unconditionally. Unconditioanal
waited barrier will never gets signalled if we predicate SEND with
gateway message.

Cc: mesa-stable
Signed-off-by: Sagar Ghuge <sagar.ghuge@intel.com>
Reviewed-by: Calder Young <calder.young@intel.com>
Reviewed-by: Alyssa Rosenzweig <alyssa@rosenz.ca>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46259>
---
 src/intel/compiler/jay/jay_opt_predicate.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/intel/compiler/jay/jay_opt_predicate.c b/src/intel/compiler/jay/jay_opt_predicate.c
index 4be13286eaec..214b346d573c 100644
--- a/src/intel/compiler/jay/jay_opt_predicate.c
+++ b/src/intel/compiler/jay/jay_opt_predicate.c
@@ -25,6 +25,9 @@ predicate_block(jay_builder *b,
     * Predicating uniform instructions only works with uniform flags (where we
     * know lane 0 is set correctly and we're not electing another lane).
     * NoMask-forced opcode hit this and are mostly unpredicatable anyway.
+    *
+    * Don't predicate SEND with GATEWAY message. Jay scoreboarding pass insert
+    * sync.bar unconditionally.
     */
    jay_foreach_inst_in_block(block, I) {
       if (jay_uses_implicit_flag(I) ||
@@ -32,6 +35,8 @@ predicate_block(jay_builder *b,
           I->op == JAY_OPCODE_MIN ||
           I->op == JAY_OPCODE_MAX ||
           I->op == JAY_OPCODE_CSEL ||
+          (I->op == JAY_OPCODE_SEND &&
+           jay_send_sfid(I) == GEN_SFID_MESSAGE_GATEWAY) ||
           jay_opcode_infos[I->op].no_mask ||
           (!uniform_condition && I->uniform) ||
           (--limit) < 0)
