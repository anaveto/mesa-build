diff -ruN a/src/intel/dev/intel_debug.c b/src/intel/dev/intel_debug.c
--- a/src/intel/dev/intel_debug.c	2026-11-24 17:06:35
+++ b/src/intel/dev/intel_debug.c	2026-11-24 17:06:35
@@ -327,7 +327,10 @@
 intel_use_jay(const struct intel_device_info *devinfo, nir_shader *nir)
 {
    /* For using nir_shader_bisect.py with toggling jay/brw: */
-   // return nir_shader_bisect_select(nir);
+   if (nir->info.stage == MESA_SHADER_FRAGMENT &&
+       (getenv("NIR_SHADER_BISECT_LO") || getenv("NIR_SHADER_BISECT_HI")))
+      return intel_use_jay_for_stage(devinfo, nir->info.stage) &&
+             nir_shader_bisect_select(nir);
 
    return intel_use_jay_for_stage(devinfo, nir->info.stage);
 }
